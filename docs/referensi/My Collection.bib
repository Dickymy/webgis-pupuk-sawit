@article{Yosephine2023,
abstract = {Manajemen Pemupukan merupakan rangkaian proses kegiatan pemupukan dimulai dari perencanaan, pembagian tugas dan fungsi karyawan, pelaksanaan dan pengendalian. Tujuan penelitian untuk mengetahui dan memahami manajemen pemupukan tanaman menghasilkan kelapa sawit (Elaeis guineensis Jacq.) berdasarkan fungsi manajemen dan mendeskripsikan fenomena-fenomena yang terjadi di Lapangan. Penelitian dilakukan di Afdeling I kebun Tanah Raja PT Bakrie Sumatera Plantation (BSP) pada bulan April – Juli 2020. Penelitian ini menggunakan metode deskriptif kulitatif dengan mengumpulkan data primer dari kuesioner melalui wawancara dan mengamati fenomena di lapangan dan pengumpulan data sekunder. Hasil penelitian menunjukkan bahwa (1) Manajemen pemupukan Tanaman menghasilkan kelapa sawit terdiri atas: (a) Perencanaan (Planning) yang meliputi penyusunan RKAP, pengambilan contoh daun (KCD), rekomendasi pemupukkan, persiapan lapangan, peralatan dan pengangkutan. (b) Organisasi (Organizing) merupakan pembagian pekerjaan untuk pemupukan yang berjumlah 17 tenaga kerja dan terdiri atas 10 tenaga kerja penabur, 5 tenaga kerja pengecer dan 2 tenaga kerja bongkar muat. (c) Pelaksanaan (Actuating) yang kegiatannya terdiri atas persiapan pemupukan dan aplikasi pemupukan. (d) Pengawasan (Controlling) yaitu asisten Afdeling di bantu oleh mandor perawatan mengawasi langsung kegiatan pemupukansecara rinci dan menyeluruh. (2) Fenomena yang terjadi dilapangan adalah pengaplikasian pupuk ke tanaman kelapa sawit belum sesuai dengan rekomendasi pemupukan hal ini disebabkan karena adanya penggunaan pupuk majemuk (NPK) diluar dari rekomendasi pemupukan dan kurangnya ketersedian pupuk di gudang dikarenakan proses pengiriman pupuk yang lama dari kantor pusat.},
author = {Yosephine, dan Butar-Butar (Ningsih},
doi = {10.56211/tabela.v1i2.269},
file = {:E\:/Skripsi/jurnal mendeley/61-69+Manajemen+Pemupukan+Tanaman+Menghasilkan+Kelapa+Sawit+(Elaeis+guineensis+Jacq.)+Di+Afdeling+I+Kebun+Tanah+Raja+PT+Bakrie+Sumatera+.pdf:pdf;:E\:/Skripsi/jurnal mendeley/Ningsih, Yosephine, Butar-Butar - 2023 - Manajemen Pemupukan Tanaman Menghasilkan Kelapa Sawit (Elaeis guineensis Jacq.) di Afdeling I K.pdf:pdf},
journal = {Tabela Jurnal Pertanian Berkelanjutan},
number = {2},
pages = {61--69},
title = {{Manajemen Pemupukan Tanaman Menghasilkan Kelapa Sawit (Elaeis guineensis Jacq.) di Afdeling I Kebun Tanah Raja PT Bakrie Sumatera Plantations}},
volume = {1},
year = {2023}
}
@article{Abdillah2023,
abstract = {Pada penelitian ini dilakukan pengujian sistem berupa website sekolah pada MI Miaftahul Ulum Warugunung Surabaya dengan menggunakan metode black box testing dan usability testing. Metode black box testing berfokus pada pengujian fungsional sistem. Metode usability testing berfokus pada kepuasan pengguna dalam pengalaman menggunakan sistem. Pada metode usability testing menggunakan USE Quesionnaire yang terdiri dari empat dimensi diantaranya usefulness (kegunaan), ease of use (kemudahan untuk digunakan), ease of learning (kemudahan untuk dipelajari) dan satisfaction (kepuasan). Hasil black box testing menunjukkan dari 30 fitur sistem yang diuji, semua fitur berhasil berjalan sukses sesuai dengan hasil yang diharapkan. Pengujian usability testing menghasilkan nilai usability sebesar 0,90 dengan mendekati nilai 1 sehingga website termasuk sistem informasi yang baik.},
author = {Abdillah, Muhammad Taufik and Kurniastuti, Ima and Susanto, Fajar Annas and Yudianto, Firman},
doi = {10.55732/jikdiskomvis.v8i1.897},
file = {:E\:/Skripsi/jurnal mendeley/234+-+242.pdf:pdf;:E\:/Skripsi/jurnal mendeley/Abdillah et al. - 2023 - Implementasi Black Box Testing dan Usability Testing pada Website Sekolah MI Miftahul Ulum Warugunung Surabaya.pdf:pdf},
issn = {2541-4550},
journal = {Journal of Computer Science and Visual Communication Design},
keywords = {black box testing,system testing,usability testing,use,website},
number = {1},
pages = {234--242},
title = {{Implementasi Black Box Testing dan Usability Testing pada Website Sekolah MI Miftahul Ulum Warugunung Surabaya}},
volume = {8},
year = {2023}
}
@article{Mardiana2024,
abstract = {Pendidikan saat ini semakin dihadapkan pada tantangan untuk mengintegrasikan teknologi dalam proses pembelajaran guna meningkatkan kualitas dan aksesibilitas. Dalam konteks ini, pengembangan Learning Management System (LMS) menggunakan framework Laravel dan Tailwind CSS menjadi solusi yang menarik. Oleh karena itu, tujuan penelitian ini adalah untuk mengembangkan Learning Management System dengan menggunakan framework laravel dan Tailwind CSS dalam pengembangannya, yang diharapkan dengan pengembangan LMS ini dapat tercipta sebuah solusi teknologi yang mampu meningkatkan kualitas pembelajaran serta memberikan aksesibilitas yang lebih luas terhadap sumber pembelajaran. Pendekatan research and development (R&D) digunakan dalam penelitian ini, yang melibatkan identifikasi masalah serta menganalisis kebutuhan, desain konsep solusi, pengembangan media LMS, melakukan pengujian, dan validasi media. Hasil evaluasi menunjukkan validasi yang signifikan, dengan 81,9% validasi oleh dosen dan 100% oleh guru, serta rata-rata validasi sebesar 90,95%, memposisikan LMS dalam kategori "sangat baik" dan layak digunakan sebagai platform pembelajaran online. Dengan demikian, pengembangan LMS dengan menggunakan framework Laravel dan Tailwind CSS telah terbukti efisien dan bermanfaat, memberikan solusi yang relevan terhadap kualitas dan aksesibilitas pembelajaran.Education today is increasingly faced with the challenge of integrating technology in the learning process to improve quality and accessibility. In this context, the development of Learning Management System (LMS) using Laravel framework and Tailwind CSS becomes an interesting solution. Therefore, the purpose of this research is to develop a Learning Management System using Laravel framework and Tailwind CSS in its development, which is expected to create a technological solution that can improve the quality of learning and provide wider accessibility to learning resources. A research and development (R&D) approach is used in this study, which involves problem identification and needs analysis, solution concept design, LMS media development, testing, and media validation. The evaluation results showed significant validation, with 81.9% validation by lecturers and 100% by teachers, as well as an average validation of 90.95%, positioning the LMS in the "excellent" category and feasible to use as an online learning platform. Thus, the development of LMS using Laravel framework and Tailwind CSS has proven to be efficient and useful, providing relevant solutions to the quality and accessibility of learning.},
